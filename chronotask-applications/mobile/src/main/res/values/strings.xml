    <!-- 关于应用 - 特性描述 -->
    <string name="feature_calendar">日历化清单管理</string>
    <string name="feature_timer">沉浸式计时体验</string>
    <string name="feature_stats">智能数据统计</string>
    <string name="feature_rest">休息模式</string>
    <string name="feature_calendar_desc">将任务无缝集成至日历视图，直观掌控每日安排，拖拽调整，灵活应对变化。</string>
    <string name="feature_timer_desc">支持正时与倒计时，全屏沉浸模式屏蔽干扰，极简界面让您专注当下任务。</string>
    <string name="feature_stats_desc">多维度解析时间去向，生成可视化图表，帮助您复盘工作效率，优化时间分配。</string>
    <string name="feature_rest_desc">科学规划工作与休息间隔，防止过度疲劳，白噪音辅助放松，快速恢复精力。</string>
    <string name="app_description">Chronos Logic 是一款专为深度工作者设计的时间管理工具。通过日历化的任务视图和沉浸式计时体验，帮助您更高效地管理每一天的时间。</string>

